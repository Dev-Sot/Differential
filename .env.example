# MEDI-IA — Variables de entorno
# Copia este archivo a .env y completa tus valores

# API Key de Anthropic (Claude)
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo de Claude a usar
# Opciones: claude-haiku-4-5-20251001 (rapido/barato) | claude-sonnet-4-6 (mejor calidad)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Contrasena para proteger el acceso a la aplicacion
# Si no se define, la autenticacion esta desactivada (modo desarrollo)
AUTH_PASSWORD=

# Modelo cross-encoder para reranking (default: multilingue mMARCO)
# Alternativa mas pequena: cross-encoder/mmarco-mMiniLMv2-L6-H384-v1
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Threshold de fallback del reranker. Chunks con score < umbral se descartan.
# Ajustar hacia 0 si hay demasiados falsos positivos; hacia -6 si hay demasiados fallbacks.
RERANK_THRESHOLD=-3.0

# Puerto del servidor Flask
PORT=5000

# Modo debug de Flask (False en produccion)
FLASK_DEBUG=False
