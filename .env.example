# MEDI-IA — Variables de entorno
# Copia este archivo a .env y completa tus valores

# ── LLM (HuggingFace) ────────────────────────────────────────────────────────
# Token de HuggingFace — HABILITA el agente ReAct (Qwen2.5-7B)
# Sin este token el sistema cae a modo RAG-template (sin LLM, respuestas crudas)
# Obtener en: https://huggingface.co/settings/tokens
HF_TOKEN=

# Modelo LLM a usar via HuggingFace Inference API
# Default: Qwen/Qwen2.5-7B-Instruct  (7B params, gratuito con token)
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Clave secreta de Flask para firmar cookies de sesion
# DEBE ser un string largo y aleatorio en produccion. Sin esto las sesiones
# se invalidan cada vez que el servidor reinicia.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Contrasena para proteger el acceso a la aplicacion
# Si no se define, la autenticacion esta desactivada (modo desarrollo local)
AUTH_PASSWORD=

# ── Reranker ─────────────────────────────────────────────────────────────────
# Modelo cross-encoder para reranking (default: multilingue mMARCO 26 idiomas)
# Alternativa mas ligera: cross-encoder/mmarco-mMiniLMv2-L6-H384-v1
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Threshold de fallback del reranker. Chunks con score < umbral activan fallback semantico.
# Chunks relevantes suelen marcar > 0; < -3 indica baja relevancia.
# Bajar hacia -6 si hay demasiados fallbacks; subir hacia 0 si hay falsos positivos.
RERANK_THRESHOLD=-3.0

# ── Servidor ──────────────────────────────────────────────────────────────────
# Puerto del servidor Flask / Gunicorn
PORT=5000

# Modo debug de Flask (NUNCA True en produccion)
FLASK_DEBUG=False

# Ruta alternativa para la base de datos SQLite de sesiones
# Default: data/memory.db (relativo a la raiz del proyecto)
# MEMORY_DB_PATH=/ruta/personalizada/memory.db
